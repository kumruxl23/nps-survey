{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteNpsTables",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DescribeTable"
      ],
      "Resource": [
        "arn:aws:dynamodb:ap-south-1:399016860083:table/Nps*",
        "arn:aws:dynamodb:ap-south-1:399016860083:table/Nps*/index/*"
      ]
    }
  ]
}
